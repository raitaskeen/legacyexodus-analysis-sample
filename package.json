{
  "name": "legacyexodus-analysis-sample",
  "version": "0.1.0",
  "description": "Public source-visible engineering sample demonstrating deterministic AST-driven control-flow graph construction, literal false branch pruning, and explicit uncertainty detection for TypeScript and JavaScript.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "legacyexodus-analyze": "./src/cli/index.ts"
  },
  "scripts": {
    "analyze": "bun run src/cli/index.ts",
    "demo": "vite demo --port 3000",
    "demo:build": "vite build demo --outDir ../dist/demo",
    "build": "tsc --noEmit && vite build demo --outDir ../dist/demo",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests demo",
    "format": "biome format --write src tests demo",
    "format:check": "biome format src tests demo",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@babel/parser": "8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
